---
import { getCollection } from 'astro:content';
import '../../writing.css';
const posts = (await getCollection('writing', ({ data }) => !data.draft && data.date <= new Date()))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const format = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Essays and notes by Jiwoon Choi."/><title>Writing — Jiwoon Choi</title></head><body><div class="page"><header class="masthead"><a href="/">Jiwoon Choi</a><nav aria-label="Main"><a href="/">Home</a><a href="/writing/" aria-current="page">Writing</a></nav></header><main><h1>Writing</h1><p class="intro">Essays and notes.</p>{posts.length ? <ol class="essay-list">{posts.map(post => <li><a href={`/writing/${post.id}/`}>{post.data.title}</a><p class="date"><time datetime={post.data.date.toISOString().slice(0,10)}>{format(post.data.date)}</time></p></li>)}</ol> : <p class="empty">No essays published yet.</p>}</main><footer>© {new Date().getFullYear()} Jiwoon Choi</footer></div></body></html>
