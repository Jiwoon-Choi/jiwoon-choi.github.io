---
import '../portfolio.css';
import RobotHero from '../components/robot/RobotHero.jsx';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Jiwoon Choi — software, robotics, intelligent systems, projects and writing." /><title>Jiwoon Choi</title></head><body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <div class="name">Jiwoon Choi</div>
        <div class="tag">Software · Robotics · Intelligent Systems</div>
      </div>
      <nav>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#research">Research</a>
        <a href="/writing/">Writing</a>
        <a href="#resume">Resume</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main class="wrap home-main">

  <!-- Hero: introduction + interactive robot -->
  <section class="home-hero" id="about">

    <div class="home-hero-intro">
      <p class="home-eyebrow">
        SOFTWARE · ROBOTICS · AUTONOMY
      </p>

      <div class="home-identity">
        <img
          src="/profile.jpg"
          alt="Portrait of Jiwoon Choi"
          class="home-avatar"
          width="76"
          height="76"
        />

        <h1>Jiwoon Choi</h1>
      </div>

      <p class="home-description">
        I'm a master's student at the
        University of Pennsylvania (MAS-CS),
        interested in software systems, robotics,
        and embodied intelligence.
      </p>

      <p class="home-background">
        Previously an officer in the
        Republic of Korea Army.
      </p>

      <div class="home-hero-links">
        <a class="home-primary-link" href="#projects">
          Explore my work →
        </a>

        <a
          class="home-secondary-link"
          href="/resume_jiwoon_choi.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          View Resume ↗
        </a>
      </div>

      <div class="home-social-links">
        <a
          href="https://github.com/Jiwoon-Choi"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>

        <a
          href="https://www.linkedin.com/in/jiwoon-choi-117602249/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn ↗
        </a>

        <a href="mailto:zzjoe4115@gmail.com">
          Email ↗
        </a>
      </div>
    </div>

    <div class="home-hero-visual">
      <RobotHero client:only="react" />
    </div>

  </section>

  <!-- Existing portfolio sections -->
  <div class="home-sections">

        <section id="projects">
          <h2>Selected Work</h2>

          <div class="item">
            <div class="title">Collaborative Robot Assistant (Simulation, Ongoing)</div>
            <div class="sub">ROS 2 • Gazebo • Speech/NLU (EN/KR mode) • CV (YOLO) • Navigation/Manipulation • FSM</div>

            <p>
              Simulation-based collaborative assistant that executes spoken commands to navigate, perceive, and manipulate objects.
              Designed as a modular ROS 2 system: speech → language grounding (intent) → FSM executor → perception/navigation/manipulation → Gazebo.
            </p>

            <p class="sub" style="margin-top:8px;">
              Current progress: custom ROS 2 message interfaces (Intent / ExecutionState) + working FSM-based executor node +
              end-to-end intent → execution-state feedback pipeline verified.
            </p>

            <p class="project-links">
              <a
                href="https://github.com/Jiwoon-Choi/collaborative-robot-assistant"
                target="_blank"
                rel="noopener noreferrer"
              >
                View source code on GitHub ↗
              </a>
            </p>

            <details style="margin-top:10px;">
              <summary style="cursor:pointer;color:var(--link);">View architecture diagram</summary>
              <pre style="margin-top:10px; white-space:pre; overflow:auto; padding:12px; border:1px solid var(--border); border-radius:12px; background:var(--card);">
User (Voice)
  ↓
Wake Word / Mode Selector (EN / KR)
  ↓
ASR (Speech → Text)
  ↓
NLU / Intent Parser
  ↓  (cra_msgs/Intent)
Executor Node (FSM)
  ├─ Navigation (Nav2)
  ├─ Perception (Camera + LiDAR, YOLO)
  └─ Manipulation (MoveIt 2)
  ↓
Gazebo Simulation (Mobile Base + Arm)
</pre>
            </details>
          </div>
          
          <div class="item">
            <div class="title">Voice-Controlled RGB LED System</div>
            <div class="sub">Raspberry Pi • Speech interface • Hardware control</div>
            <p>
              Voice-controlled system that recognizes spoken commands and controls an RGB LED on a Raspberry Pi.
              <a href="https://github.com/Jiwoon-Choi/raspi-voice-led-control" target="_blank">GitHub</a>
            </p>
          </div>
          
          <div class="item">
            <div class="title">Voice-Based Weather Assistant</div>
            <div class="sub">Raspberry Pi • Speech interface • Weather API</div>
            <p>
              Voice-based assistant that answers weather queries using speech recognition and live weather data.
              <a href="https://github.com/Jiwoon-Choi/raspi-voice-weather-assistant" target="_blank">GitHub</a>
            </p>
          </div>
        </section>

        <section id="education">
          <h2>Education</h2>
          <ul class="list">
            <li><strong>University of Pennsylvania</strong> — MAS-CS, expected May 2028</li>
            <li><strong>Korea Military Academy</strong> — B.A. in Military English; B.M.A.S. in Military Art and Science</li>
            <li>Additional coursework in mathematics, computer science, and linguistics through accredited institutions.</li>
          </ul>
        </section>

        <section id="interests">
          <h2>Current Technical Interests</h2>
          <ul class="list">
            <li>Robotics software and autonomy: perception, navigation, and manipulation</li>
            <li>Computer systems and the interface between software and hardware</li>
            <li>Embodied AI and human–robot collaboration</li>
            <li>Speech and language interfaces for robots in real-world environments</li>
            <li>Space robotics and autonomous exploration</li>
          </ul>
        </section>

        <section id="research">
          <h2>Research</h2>
          <div class="item">
            <div class="title">Future Army Project (ROK Army × Seoul National University)</div>
            <div class="sub">Scenario modeling • Qualitative analysis • Mar 2019 – Jul 2019</div>
            <p>
              Selected as one of the eight cadets from the Korea Military Academy to take part in a joint research program for a semester.
            </p>
            <p>
              Analyzed the strategic impact of emerging technologies (AI, automation, cyber operations) on U.S.–China competition.
            </p>
          </div>
        </section>

        <section id="writing">
          <h2>Writing</h2>
          <p>Essays and notes on things I find interesting.</p>
          <a href="/writing/">Read my writing →</a>
        </section>

        <section id="resume">
          <h2>Resume</h2>
          <p>
            A summary of my technical skills,
            engineering projects, education,
            and professional experience.
          </p>

          <a
            class="pill"
            href="/resume_jiwoon_choi.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            📄 View Resume (PDF) ↗
          </a>
        </section>

        <section id="contact">
          <h2>Contact</h2>
          <p>Email: <a href="mailto:zzjoe4115@gmail.com">zzjoe4115@gmail.com</a></p>
        </section>
      </div>
    </main>

    <footer>
    © {new Date().getFullYear()} Jiwoon Choi
  </footer>

</body></html>
