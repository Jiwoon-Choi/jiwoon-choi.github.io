<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Jiwoon Choi — software, robotics, intelligent systems, projects and writing." /><title>Jiwoon Choi</title></head><body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <div class="name">Jiwoon Choi</div>
        <div class="tag">Software · Robotics · Intelligent Systems</div>
